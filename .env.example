# Optional initial provider override (does not restrict the chooser). Codex uses the authenticated local Codex CLI.
DEXTERO_MODEL_PROVIDER=

# The selected model and the choices shown before a conversation starts.
DEXTERO_CODEX_MODEL=
DEXTERO_CODEX_MODELS=gpt-5.3-codex-spark,default

# Anthropic is selected automatically when this key is non-empty unless the
# provider above names another provider. Use a key from a dedicated Console
# workspace with a spend limit.
ANTHROPIC_API_KEY=
DEXTERO_ANTHROPIC_MODEL=claude-haiku-4-5
DEXTERO_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5-5

# Without an Anthropic key, Gemini is selected when this is non-empty unless
# the provider above is set to codex. Without either key, Codex Spark is used.
GEMINI_API_KEY=
DEXTERO_GEMINI_MODEL=gemini-2.5-flash
DEXTERO_GEMINI_MODELS=gemini-2.5-flash

# Optional local client and workspace overrides.
# CONTROL_URL=http://localhost:8080/
# WORKSPACE=/absolute/path/to/a/workspace
