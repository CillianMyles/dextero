# Optional initial provider override (does not restrict the chooser). Codex uses the authenticated local Codex CLI.
DEXTERO_MODEL_PROVIDER=

# The selected model and the choices shown before a conversation starts.
DEXTERO_CODEX_MODEL=
DEXTERO_CODEX_MODELS=gpt-5.3-codex-spark,default

# Gemini is selected automatically when this is non-empty unless the provider
# above is explicitly set to codex. Without a key, Codex Spark is selected.
GEMINI_API_KEY=
DEXTERO_GEMINI_MODEL=gemini-2.5-flash
DEXTERO_GEMINI_MODELS=gemini-2.5-flash

# Optional push-to-talk. Voice stays off unless this is the absolute path of a
# whisper.cpp model such as ggml-base.bin. Audio is transcribed on this
# computer. Spoken replies use macOS `say` by default on macOS; set
# DEXTERO_SPEECH_OUTPUT=off to disable them.
DEXTERO_WHISPER_MODEL=
DEXTERO_WHISPER_CLI=whisper-cli
DEXTERO_WHISPER_LANGUAGE=auto
DEXTERO_SPEECH_OUTPUT=
DEXTERO_SPEECH_VOICE=

# Optional local client and workspace overrides.
# CONTROL_URL=http://localhost:8080/
# WORKSPACE=/absolute/path/to/a/workspace
