# Local model provider. Codex uses the authenticated local Codex CLI.
DEXTERO_MODEL_PROVIDER=codex

# The selected model and the choices shown before a conversation starts.
DEXTERO_CODEX_MODEL=default
DEXTERO_CODEX_MODELS=default,gpt-5.3-codex-spark

# Gemini is selected automatically when this is non-empty unless the provider
# above is explicitly set to codex.
GEMINI_API_KEY=
DEXTERO_GEMINI_MODEL=gemini-2.5-flash
DEXTERO_GEMINI_MODELS=gemini-2.5-flash

# Optional local client and workspace overrides.
# CONTROL_URL=http://localhost:8080/
# WORKSPACE=/absolute/path/to/a/workspace
# DEXTERO_STATE_DIRECTORY=/absolute/path/to/local/state
# DEXTERO_CONTROLLER_ID=controller_0123456789abcdef
# DEXTERO_CONTROLLER_NAME=Personal MacBook
